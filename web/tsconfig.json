{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["../test/*"],
      "vitest": ["./node_modules/vitest"],
      "playwright-core": ["./node_modules/playwright-core"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "../test/**/*.test.ts", "vitest.config.ts", "../test/**/*.test.js"]
}
