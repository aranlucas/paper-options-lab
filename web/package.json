{
  "name": "paper-options-lab-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "cd .. && oxlint",
    "lint:fix": "cd .. && oxlint --fix",
    "format": "cd .. && oxfmt --write --config web/oxfmt.config.ts web test",
    "format:check": "cd .. && oxfmt --check --config web/oxfmt.config.ts web test",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "1.64.1",
    "portless": "0.15.8",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@aranlucas/oxforge": {
      "oxfmt": "$oxfmt"
    }
  }
}
